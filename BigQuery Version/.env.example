# Copy this file to .env and fill in local values. Never commit .env.
#
# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=your-gcp-project-number
BQ_LOCATION=asia-southeast2
BQ_RAW_DATASET=raw
BQ_STAGING_DATASET=staging
BQ_ANALYTICS_DATASET=analytics
BQ_SNAPSHOTS_DATASET=snapshots
BQ_METABASE_KEY_PATH=.secrets/metabase-bigquery-key.json

# Local Docker / Metabase application database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=airbnb
POSTGRES_PORT=5433
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password
PGADMIN_PORT=5050
METABASE_PORT=3000
METABASE_URL=http://127.0.0.1:3000
METABASE_ADMIN_EMAIL=admin@example.com
# Metabase rejects common dictionary passwords; use a strong one.
METABASE_ADMIN_PASSWORD=replace-with-a-strong-password
METABASE_ADMIN_FIRST_NAME=Airbnb
METABASE_ADMIN_LAST_NAME=Admin
MB_SITE_URL=http://localhost:3000
TZ=Asia/Jakarta
