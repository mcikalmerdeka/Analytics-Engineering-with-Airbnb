  "entity_id": "qDsRe8xe5pQjvNPgT6fQM",
  "name": "Chart - Listings by Room Type",
  "description": "Filtered listings by room type. One row per listing; the chart collapses to one bar when the Room type filter is applied.",
  "collection_id": 10,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    room_type,\n    COUNT(*) AS listings\nFROM analytics.mart_listing_performance\nWHERE 1 = 1\n  AND {{room_type}}\n  AND {{price_band}}\n  AND {{minimum_nights_band}}\n  AND {{is_superhost}}\n  AND {{host_segment}}\n  AND {{is_active_last_12m}}\n  AND {{price}}\nGROUP BY room_type\nORDER BY listings DESC;",
        "lib/type": "mbql.stage/native",
