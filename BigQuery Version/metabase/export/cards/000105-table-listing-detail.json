  "entity_id": "LA6EkGF0ZdV4NHEcxhopI",
  "name": "Table - Listing Detail",
  "description": "One row per listing with price, host, portfolio segment, activity, lifetime and 12-month reviews, sentiment, and recency for drill-down and verification.",
  "collection_id": 10,
  "type": "question",
  "query_type": "native",
  "display": "table",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    listing_id,\n    listing_name,\n    room_type,\n    price,\n    price_band,\n    minimum_nights,\n    host_name,\n    host_segment,\n    is_superhost,\n    review_count,\n    review_count_12m,\n    avg_sentiment,\n    pct_positive,\n    last_review_date,\n    is_active_last_12m,\n    days_since_last_review\nFROM analytics.mart_listing_performance AS mart_listing_performance\nWHERE 1 = 1\n  AND {{room_type}}\n  AND {{price_band}}\n  AND {{minimum_nights_band}}\n  AND {{is_superhost}}\n  AND {{host_segment}}\n  AND {{is_active_last_12m}}\n  AND {{price}}\nORDER BY review_count DESC\nLIMIT 200;",
        "lib/type": "mbql.stage/native",
