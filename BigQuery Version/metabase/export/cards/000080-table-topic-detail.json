  "name": "Table - Topic Detail",
  "description": "Monthly topic mentions, mention rate, average sentiment, and negative share for the last 12 complete months. One row per month and topic.",
  "collection_id": 8,
  "type": "question",
  "query_type": "native",
  "display": "table",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    month_start,\n    topic,\n    mentions,\n    mention_rate,\n    avg_sentiment,\n    pct_negative\nFROM analytics.mart_review_topics AS mart_review_topics\nWHERE month_start BETWEEN DATE '2020-11-01' AND DATE '2021-10-01'\n  AND {{review_month}}\n  AND {{topic}}\nORDER BY mentions DESC\nLIMIT 1000;",
