  "entity_id": "29uYSTQJyI6KMuleAUUn2",
  "name": "Chart - Price Band by Room Type",
  "description": "Listings by price band and room type. One row per price band and room type; the spine is zero-filled, so all 28 combinations exist.",
  "collection_id": 7,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    price_band,\n    room_type,\n    SUM(listing_count) AS listings\nFROM analytics.mart_price_bands\nWHERE 1 = 1\n  AND {{room_type}}\n  AND {{price_band}}\nGROUP BY price_band, room_type\nORDER BY CASE price_band\n    WHEN '<30' THEN 1\n    WHEN '30-49' THEN 2\n    WHEN '50-74' THEN 3\n    WHEN '75-99' THEN 4\n    WHEN '100-149' THEN 5\n    WHEN '150-249' THEN 6\n    ELSE 7\nEND, room_type;",
        "lib/type": "mbql.stage/native",
