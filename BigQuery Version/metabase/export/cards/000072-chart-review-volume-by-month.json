  "name": "Chart - Review Volume by Month",
  "description": "Reviews submitted per month through 2021-10. One row per month; 2021-11 is excluded because review data ends in October.",
  "collection_id": 8,
  "type": "question",
  "query_type": "native",
  "display": "line",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    review_month,\n    COUNT(*) AS reviews\nFROM analytics.fct_reviews\nWHERE review_month <= DATE '2021-10-01'\n  AND {{review_date}}\n  AND {{review_sentiment}}\n  AND {{has_comment}}\nGROUP BY review_month\nORDER BY review_month;",
