{
  "id": 78,
  "entity_id": "0IJUCUTv1Tk-VMAoJGRp3",
  "name": "Chart - Topic Mention Rate Trend",
  "description": "Average monthly share of comment-bearing reviews that mention each topic, for the last 24 complete months. One row per month and topic; unweighted average of monthly rates.",
  "collection_id": 8,
  "type": "question",
  "query_type": "native",
  "display": "line",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    month_start,\n    topic,\n    AVG(mention_rate) AS avg_mention_rate\nFROM analytics.mart_review_topics AS mart_review_topics\nWHERE month_start BETWEEN DATE '2019-11-01' AND DATE '2021-10-01'\n  AND {{review_month}}\n  AND {{topic}}\nGROUP BY month_start, topic\nORDER BY month_start, topic;",
        "lib/type": "mbql.stage/native",
