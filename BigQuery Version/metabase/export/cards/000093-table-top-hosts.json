  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    host_name,\n    host_segment,\n    is_superhost,\n    listing_count,\n    active_listing_count,\n    total_reviews,\n    avg_reviews_per_listing,\n    avg_sentiment\nFROM analytics.mart_host_performance AS mart_host_performance\nWHERE 1 = 1\n  AND {{host_segment}}\n  AND {{is_superhost}}\n  AND {{listing_count}}\nORDER BY total_reviews DESC\nLIMIT 100;",
