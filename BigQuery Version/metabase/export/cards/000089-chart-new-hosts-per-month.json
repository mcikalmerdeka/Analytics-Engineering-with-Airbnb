  "name": "Chart - New Hosts per Month",
  "description": "Host profiles created per month from 2015 onward. One row per host; this is new hosts, not cumulative hosts.",
  "collection_id": 9,
  "type": "question",
  "query_type": "native",
  "display": "line",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    DATE_TRUNC(DATE(host_created_at), MONTH) AS month_start,\n    COUNT(*) AS new_hosts\nFROM analytics.dim_hosts AS dim_hosts\nWHERE DATE(host_created_at) >= DATE '2015-01-01'\n  AND {{host_created_at}}\nGROUP BY 1\nORDER BY 1;",
