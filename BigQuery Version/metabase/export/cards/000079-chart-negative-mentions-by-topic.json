  "entity_id": "yUcXIDFHIpg5zcFVfMjQg",
  "name": "Chart - Negative Mentions by Topic",
  "description": "Average share of topic mentions with negative sentiment, by topic. One row per month and topic rolled up; unweighted average across months.",
  "collection_id": 8,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    topic,\n    AVG(pct_negative) AS avg_pct_negative\nFROM analytics.mart_review_topics AS mart_review_topics\nWHERE 1 = 1\n  AND {{review_month}}\n  AND {{topic}}\nGROUP BY topic\nORDER BY avg_pct_negative DESC;",
