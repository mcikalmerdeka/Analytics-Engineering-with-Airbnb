  "name": "Chart - Active Listings by Host Segment",
  "description": "Active filtered listings by host portfolio segment. One row per listing; this is listing-grain, not host-grain.",
  "collection_id": 10,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    host_segment,\n    COUNT(*) AS active_listings\nFROM analytics.mart_listing_performance AS mart_listing_performance\nWHERE is_active_last_12m = TRUE\n  AND {{room_type}}\n  AND {{price_band}}\n  AND {{minimum_nights_band}}\n  AND {{is_superhost}}\n  AND {{price}}\nGROUP BY host_segment\nORDER BY active_listings DESC;",
