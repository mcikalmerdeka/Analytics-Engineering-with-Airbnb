    "stages": [
      {
        "native": "SELECT\n    review_sentiment,\n    COUNT(*) AS reviews\nFROM analytics.fct_reviews\nWHERE 1 = 1\n  AND {{review_date}}\n  AND {{review_sentiment}}\n  AND {{has_comment}}\nGROUP BY review_sentiment\nORDER BY reviews DESC;",
