  "name": "Chart - Avg Listings per Host by Segment",
  "description": "Mean number of listings per host within each segment. One row per host; host-grain calculation.",
  "collection_id": 9,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    host_segment,\n    AVG(listing_count) AS avg_listings\nFROM analytics.mart_host_performance\nWHERE 1 = 1\n  AND {{host_segment}}\n  AND {{is_superhost}}\n  AND {{listing_count}}\nGROUP BY host_segment\nORDER BY avg_listings DESC;",
