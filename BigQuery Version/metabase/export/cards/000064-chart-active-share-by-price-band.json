{
  "id": 64,
  "entity_id": "lgIp0NkIWOFJ6a851uGBr",
  "name": "Chart - Active Share by Price Band",
  "description": "Unweighted average of room-type active shares within each price band. One row per price band; active means a review in the trailing 12 months.",
  "collection_id": 7,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    price_band,\n    AVG(pct_active) AS active_share\nFROM analytics.mart_price_bands\nWHERE 1 = 1\n  AND {{room_type}}\n  AND {{price_band}}\nGROUP BY price_band\nORDER BY CASE price_band\n    WHEN '<30' THEN 1\n    WHEN '30-49' THEN 2\n    WHEN '50-74' THEN 3\n    WHEN '75-99' THEN 4\n    WHEN '100-149' THEN 5\n    WHEN '150-249' THEN 6\n    ELSE 7\nEND;",
        "lib/type": "mbql.stage/native",
