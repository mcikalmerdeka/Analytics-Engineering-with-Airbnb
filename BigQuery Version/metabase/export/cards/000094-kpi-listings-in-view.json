  "name": "KPI - Listings in View",
  "description": "Count of listings matching the selected Listing Explorer filters. One row per listing; responds to every dashboard filter and is the denominator for listing-level shares.",
  "collection_id": 10,
  "type": "question",
  "query_type": "native",
