  "name": "Chart - Hosts by Segment",
  "description": "Hosts by portfolio segment. One row per host; these are host-grain counts and will not match listing-grain segment counts.",
  "collection_id": 9,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    host_segment,\n    COUNT(*) AS hosts\nFROM analytics.mart_host_performance\nWHERE 1 = 1\n  AND {{host_segment}}\n  AND {{is_superhost}}\n  AND {{listing_count}}\nGROUP BY host_segment\nORDER BY hosts DESC;",
