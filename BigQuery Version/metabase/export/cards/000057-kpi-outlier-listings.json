  "name": "KPI - Outlier Listings",
  "description": "Listings flagged as zero-price or above the p99.5 price for their room type. One row per listing; outliers stay in the data and are excluded from price averages.",
  "collection_id": 7,
  "type": "question",
  "query_type": "native",
