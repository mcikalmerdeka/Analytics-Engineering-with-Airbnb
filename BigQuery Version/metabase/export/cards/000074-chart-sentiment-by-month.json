  "name": "Chart - Sentiment by Month",
  "description": "Reviews by month and sentiment category through 2021-10. One row per month and sentiment.",
  "collection_id": 8,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    review_month,\n    review_sentiment,\n    COUNT(*) AS reviews\nFROM analytics.fct_reviews AS fct_reviews\nWHERE review_month <= DATE '2021-10-01'\n  AND {{review_date}}\n  AND {{review_sentiment}}\n  AND {{has_comment}}\nGROUP BY review_month, review_sentiment\nORDER BY review_month, review_sentiment;",
