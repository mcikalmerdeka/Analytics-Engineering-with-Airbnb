  "name": "Chart - Topic Mentions",
  "description": "Keyword-topic mentions across review comments. One row per month and topic in the source; totals exceed the review count because one review can mention multiple topics.",
  "collection_id": 8,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    topic,\n    SUM(mentions) AS mentions\nFROM analytics.mart_review_topics AS mart_review_topics\nWHERE 1 = 1\n  AND {{review_month}}\n  AND {{topic}}\nGROUP BY topic\nORDER BY mentions DESC;",
