  "name": "Chart - Hosts by Segment and Superhost",
  "description": "Host counts by segment and superhost status. One row per host; the stacked bars sum to the host total.",
  "collection_id": 9,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    host_segment,\n    is_superhost,\n    COUNT(*) AS hosts\nFROM analytics.mart_host_performance AS mart_host_performance\nWHERE 1 = 1\n  AND {{host_segment}}\n  AND {{listing_count}}\nGROUP BY host_segment, is_superhost\nORDER BY host_segment, is_superhost NULLS LAST;",
