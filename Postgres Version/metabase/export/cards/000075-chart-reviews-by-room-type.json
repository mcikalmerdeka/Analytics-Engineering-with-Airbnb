  "entity_id": "9yqOBX-BQgEYSB2A9SR3j",
  "name": "Chart - Reviews by Room Type",
  "description": "Reviews grouped by the room type of the reviewed listing. One row per review; each review belongs to one listing and one room type.",
  "collection_id": 8,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    dim_listings.room_type,\n    COUNT(*) AS reviews\nFROM analytics.fct_reviews\nINNER JOIN analytics.dim_listings\n    ON fct_reviews.listing_id = dim_listings.listing_id\nWHERE 1 = 1\n  AND {{review_date}}\n  AND {{review_sentiment}}\n  AND {{has_comment}}\n  AND {{room_type}}\nGROUP BY dim_listings.room_type\nORDER BY reviews DESC;",
        "lib/type": "mbql.stage/native",
