  "name": "Chart - Supply and Host Growth",
  "description": "Monthly cumulative listing and host counts from the dbt month spine. One row per month; values are cumulative, not new additions.",
  "collection_id": 6,
  "type": "question",
  "query_type": "native",
  "display": "line",
  "dataset_query": {
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT\n    month_start,\n    'Cumulative listings' AS metric,\n    cumulative_listings::numeric AS value\nFROM analytics.mart_executive_kpis\nWHERE 1 = 1\n  AND {{month_start}}\n\nUNION ALL\n\nSELECT\n    month_start,\n    'Cumulative hosts' AS metric,\n    cumulative_hosts::numeric AS value\nFROM analytics.mart_executive_kpis\nWHERE 1 = 1\n  AND {{month_start}}\n\nORDER BY month_start, metric;",
