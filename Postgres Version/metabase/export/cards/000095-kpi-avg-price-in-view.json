  "name": "KPI - Avg Price in View",
  "description": "Mean source nightly price of filtered listings, excluding outliers. One row per listing; currency is not normalized.",
  "collection_id": 10,
  "type": "question",
  "query_type": "native",
  "display": "scalar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
