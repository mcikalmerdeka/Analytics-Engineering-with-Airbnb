{
  "id": 104,
  "entity_id": "iuzTJx2BP86vnw76dIHVs",
  "name": "Chart - Listings by Minimum Nights",
  "description": "Filtered listings by minimum-night band. One row per listing; zero minimum nights are normalized to one upstream.",
  "collection_id": 10,
  "type": "question",
  "query_type": "native",
  "display": "bar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
        "native": "SELECT\n    minimum_nights_band,\n    COUNT(*) AS listings\nFROM analytics.mart_listing_performance\nWHERE 1 = 1\n  AND {{room_type}}\n  AND {{price_band}}\n  AND {{minimum_nights_band}}\n  AND {{is_superhost}}\n  AND {{host_segment}}\n  AND {{is_active_last_12m}}\n  AND {{price}}\nGROUP BY minimum_nights_band\nORDER BY CASE minimum_nights_band\n    WHEN '1' THEN 1\n    WHEN '2-6' THEN 2\n    WHEN '7-29' THEN 3\n    ELSE 4\nEND;",
        "lib/type": "mbql.stage/native",
