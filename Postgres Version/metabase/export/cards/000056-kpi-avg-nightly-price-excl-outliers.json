  "name": "KPI - Avg Nightly Price (excl. outliers)",
  "description": "Mean source nightly price across non-outlier listings matching the selected filters. One row per listing; sensitive to high prices.",
  "collection_id": 7,
  "type": "question",
  "query_type": "native",
  "display": "scalar",
  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 2,
    "stages": [
      {
